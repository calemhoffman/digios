#!/bin/bash -l

constFile=${HELIOSSYS}/expName.sh
source ${constFile} #load expName, etc.

source ${HELIOSSYS}/daq/edm/scripts/DataBaseAddress.sh

#==== read comment
if [ $# -eq 0 ];then
    echo 'Ctrl+C to cancel with no harm.'
    echo 'e.g. Target, beam rate, attenuation, slit, trigger, people on-shift, objective, etc... '
    read -p 'Singleline comment for this run: ' COMMENT
else
    COMMENT=$1
fi


if [ -z  "$COMMENT" ]; then  
    comment2="nan"
else
    comment2="${COMMENT// /\ }"
    comment2="${comment2//,/\,}"
fi

echo $comment2

#SS=$(caget Online_CS_StartStop | awk '{print$2}')
#if [ ${SS} == "Start" ]; then
#   vv=1
#else
#   vv=0
#fi

vv=2

curl -s -XPOST "http://${dataBaseAddress}:8086/write?db=testing" --data-binary "SavingData,expName=${expName},comment=${comment2} value=${vv}" --max-time 1 --connect-timeout 1

#============= write to elog
if [ ${expName} == "ARR01" ]; then
    elogName="ARR01"
else
    elogName="H"${expName:1}
fi

# Prefer ryan_ANL build (libcurl + HTTP/2 Location parsing); fall through to the
# older builds and finally the bare `elog` in PATH so this still works on hosts
# where the ryan build isn't installed (e.g. the DAQ).
ELOG_BIN=~/elog-ryan-build/elog
if [ ! -x "${ELOG_BIN}" ]; then ELOG_BIN=~/elog_CloudFlare/BUILD/elog; fi
if [ ! -x "${ELOG_BIN}" ]; then ELOG_BIN=~/bin/elog; fi
if [ ! -x "${ELOG_BIN}" ]; then ELOG_BIN=elog; fi

${ELOG_BIN} -h websrv1.phy.anl.gov -p 8080 -l ${elogName} -u MasterHelios helios -a Category=General -a Subject="Comments" -n 2 "${COMMENT}"
