#!/usr/bin/env python3
"""
SetChannel -- Set EPICS PV values for HELIOS 4-side silicon array channels

Usage:
  SetChannel <side> <value>                  # set led_threshold for all channels on side
  SetChannel <side> <signal> <value>         # set led_threshold for signal type on side
  SetChannel <side> <signal> <PV> <value>    # set arbitrary PV for signal type on side
  SetChannel <det> <signal> <value>          # set led_threshold for det number, signal type
  SetChannel <det> <signal> <PV> <value>     # set arbitrary PV for det number, signal type

Arguments:
  side    : Left, Bottom, Right, Top, Recoil, All
  signal  : E (Energy), XF, XN, All  |  Recoil: E, dE, All
  det     : detector number 0-23 (silicon array) or 100-107 (RDT)
  PV      : PV field suffix (default: led_threshold). Aliases: threshold -> led_threshold
  value   : numeric value to set

Settable PVs (led_threshold is default):
  led_threshold       -- LED discriminator threshold (default)
  m_window            -- M-window (energy filter)
  d_window            -- D-window
  k_window            -- K-window
  p1_window           -- P1-window
  disc_width          -- Discriminator width
  preamp_reset_delay  -- Preamp reset delay

Examples:
  SetChannel Left 400                   # all Left channels, led_threshold=400
  SetChannel Left E 400                 # Left Energy channels, led_threshold=400
  SetChannel Left E threshold 400       # same (explicit alias)
  SetChannel Left All M 100             # all Left channels, m_window=100
  SetChannel 7 E 400                    # det 7 Energy, led_threshold=400
  SetChannel 7 E m_window 100           # det 7 Energy, m_window=100
  SetChannel Recoil dE 500              # RDT dE channels, led_threshold=500
  SetChannel All 400                    # everything, led_threshold=400
  SetChannel All trace 9.0              # all boards, raw_data_length=9.0 µs (total trace)
  SetChannel 7 E preTrigger 3.0        # det 7 Energy board, raw_data_window=3.0 µs (pre-trigger)
  SetChannel Left E RL 9.0             # Left boards, raw_data_length=9.0 µs

Note: raw_data_length (trace) and raw_data_window (preTrigger) are board-level PVs (per MDIG,
      not per channel). They are set once per board regardless of signal type.
      Confirmed from EDM screen genBoard.edl:
        "Trace Length"           -> raw_data_length  (total)
        "Trace Length b4 trigger"-> raw_data_window  (pre-trigger portion)

Mapping: GeneralSortMapping.h (4-side array, 24 PSD + 8 RDT)
Updated: 2026-04-08
"""

import sys
import os

# Point pyepics at the compiled EPICS CA library
_libca = os.path.expanduser("~/epics-base/lib/linux-aarch64/libca.so")
if os.path.exists(_libca):
    os.environ.setdefault("PYEPICS_LIBCA", _libca)

import epics
import re
from collections import defaultdict

# ── PV alias map ────────────────────────────────────────────────────────────
PV_ALIASES = {
    'threshold':  'led_threshold',
    'T':          'led_threshold',
    'M':          'm_window',
    'D':          'd_window',
    'K':          'k_window',
    'P1':         'p1_window',
    'disc':       'disc_width',
    'reset':      'preamp_reset_delay',
    'raw_length': 'raw_data_length',
    'RL':         'raw_data_length',
    'trace':      'raw_data_length',   # total trace length
    'raw_delay':  'raw_data_window',
    'RD':         'raw_data_window',
    'preTrigger': 'raw_data_window',   # trace length before trigger
    'pretrigger': 'raw_data_window',
    'preTrig':    'raw_data_window',
    'pretrig':    'raw_data_window',
}

# PVs that are board-level (per MDIG, no channel suffix)
BOARD_LEVEL_PVS = {'raw_data_length', 'raw_data_window'}

SETTABLE_PVS = [
    'led_threshold    (per channel) -- LED discriminator threshold (default)',
    'm_window         (per channel) -- M-window (energy filter)',
    'd_window         (per channel) -- D-window',
    'k_window         (per channel) -- K-window',
    'p1_window        (per channel) -- P1-window',
    'disc_width       (per channel) -- Discriminator width',
    'preamp_reset_delay (per channel) -- Preamp reset delay',
    'raw_data_length  (per board)   -- Total trace length (µs)          [alias: trace, raw_length, RL]',
    'raw_data_window  (per board)   -- Trace length before trigger (µs) [alias: preTrigger, preTrig, RD]',
]

# ── Parse GeneralSortMapping.h at runtime ───────────────────────────────────
def find_mapping_file():
    """Search for GeneralSortMapping.h relative to this script or in standard locations."""
    script_dir = os.path.dirname(os.path.realpath(__file__))
    candidates = [
        # working_Helios symlink (preferred — always current experiment)
        os.path.join(script_dir, '../../../analysis/working_Helios/GeneralSortMapping.h'),
        # working/ fallback
        os.path.join(script_dir, '../../../analysis/working/GeneralSortMapping.h'),
        # explicit env override
        os.environ.get('HELIOS_MAPPING', ''),
    ]
    for p in candidates:
        if not p:
            continue
        p = os.path.normpath(p)
        if os.path.isfile(p):
            return p
    return None

def parse_int_array(text, name, expected_len=160):
    """Extract a C int array initializer by name from header text.
    Uses brace-matching to find the array body, then truncates to expected_len."""
    start = text.find(f'Int_t {name}')
    if start == -1:
        # Try with spaces
        m = re.search(rf'Int_t\s+{name}\s*\[', text)
        if not m:
            raise ValueError(f"Could not find {name} in mapping file")
        start = m.start()
    brace_start = text.index('{', start)
    depth = 0; i = brace_start; chars = []
    while i < len(text):
        c = text[i]
        if c == '{': depth += 1
        elif c == '}':
            depth -= 1
            if depth == 0: break
        # Strip comments to avoid digits in them polluting the parse
        chars.append(c)
        i += 1
    body = ''.join(chars[1:])
    # Remove line comments
    body = re.sub(r'//[^\n]*', '', body)
    nums = re.findall(r'-?\d+', body)
    return [int(x) for x in nums[:expected_len]]

def build_det_map(mapping_file):
    """Parse GeneralSortMapping.h and return (DET_MAP, NARRAY, NSIDES)."""
    with open(mapping_file) as f:
        text = f.read()

    # Read NARRAY from #define
    narray_m = re.search(r'#define\s+NARRAY\s+(\d+)', text)
    narray = int(narray_m.group(1)) if narray_m else 24

    # Get declared array size from idDetMap declaration
    size_m = re.search(r'Int_t\s+idDetMap\s*\[\s*(\d+)\s*\]', text)
    arr_size = int(size_m.group(1)) if size_m else 160

    det_map_raw  = parse_int_array(text, 'idDetMap',  arr_size)
    kind_map_raw = parse_int_array(text, 'idKindMap', arr_size)

    kind_name = {0: 'E', 1: 'XF', 2: 'XN'}
    det_map = defaultdict(dict)

    for idx, (det, kind) in enumerate(zip(det_map_raw, kind_map_raw)):
        if det == -1:
            continue
        board_idx = idx // 10
        ch = idx % 10
        vme = board_idx // 4 + 1
        dig = board_idx % 4 + 1
        # RDT (det >= 100): kindMap is -1; use det_id parity (even=E, odd=dE)
        if det >= 100:
            sig = 'dE' if det % 2 == 1 else 'E'
        else:
            if kind == -1:
                continue
            sig = kind_name.get(kind)
            if sig is None:
                continue
        # Keep first occurrence only — avoids overwriting with duplicate entries
        if sig not in det_map[det]:
            det_map[det][sig] = (vme, dig, ch)

    return dict(det_map), narray

# Load mapping
_mapping_file = find_mapping_file()
if _mapping_file is None:
    print("WARNING: GeneralSortMapping.h not found — falling back to empty map", file=sys.stderr)
    DET_MAP = {}
    NARRAY = 0
    _mapping_source = "NOT FOUND"
else:
    DET_MAP, NARRAY = build_det_map(_mapping_file)
    _mapping_source = _mapping_file

# ── Side → detector ranges ───────────────────────────────────────────────────
# 4 sides hardcoded; NARRAY detectors split equally across them
N_SIDES = 4

def _psd_dets():
    return sorted(d for d in DET_MAP if d < 100)

def _rdt_dets():
    return sorted(d for d in DET_MAP if d >= 100)

def _build_sides():
    psd = _psd_dets()
    q = NARRAY // N_SIDES   # detectors per side
    return {
        'Left':   psd[0:q],
        'Bottom': psd[q:2*q],
        'Right':  psd[2*q:3*q],
        'Top':    psd[3*q:4*q],
        'All':    psd,
        'Recoil': _rdt_dets(),
    }

SIDES = _build_sides()

def resolve_pv(pv_arg):
    """Resolve PV alias to actual PV field name."""
    return PV_ALIASES.get(pv_arg, pv_arg)

def make_pv_name(vme, dig, ch, pv_field):
    return f"VME0{vme}:MDIG{dig}:{pv_field}{ch}"

def set_channel(vme, dig, ch, pv_field, value):
    if pv_field in BOARD_LEVEL_PVS:
        pv_name = f"VME0{vme}:MDIG{dig}:{pv_field}"
    else:
        pv_name = make_pv_name(vme, dig, ch, pv_field)
    old = epics.caget(pv_name)
    if old is None:
        print(f"  [warn] {pv_name:45s}  unreachable — skipping")
        return
    epics.caput(pv_name, value)
    print(f"  {pv_name:45s}  {old} -> {value}")

def set_det_signal(det, signal, pv_field, value, boards_done):
    """Set PV for a specific detector and signal (E/XF/XN/dE/All)."""
    det_entry = DET_MAP.get(det)
    if det_entry is None:
        print(f"  [skip] det {det} not in map")
        return
    signals = list(det_entry.keys()) if signal == 'All' else [signal]
    for sig in signals:
        if sig not in det_entry:
            print(f"  [skip] det {det} has no signal {sig}")
            continue
        vme, dig, ch = det_entry[sig]
        if pv_field in BOARD_LEVEL_PVS:
            board_key = (vme, dig)
            if board_key in boards_done:
                continue
            boards_done.add(board_key)
        set_channel(vme, dig, ch, pv_field, value)

def print_help():
    print(__doc__)
    print("\nSettable PV fields:")
    for p in SETTABLE_PVS:
        print(f"  {p}")
    print("\nPV aliases:")
    for alias, real in PV_ALIASES.items():
        print(f"  {alias:12s} -> {real}")
    print(f"\nMapping source: {_mapping_source}")
    print(f"Detectors loaded: {len(_psd_dets())} PSD, {len(_rdt_dets())} RDT")

# ── Argument parsing ─────────────────────────────────────────────────────────
args = sys.argv[1:]

if not args or args[0] in ('-h', '--help', 'help'):
    print_help()
    sys.exit(0)

def is_int(s):
    try: int(s); return True
    except: return False

# Determine mode: side/det, signal, [pv], value
target = args[0]   # side name or det number

# Resolve target
if is_int(target):
    det_num = int(target)
    dets = [det_num]
    is_side = False
elif target in SIDES:
    dets = SIDES[target]
    is_side = True
else:
    print(f"Unknown target '{target}'. Use a side (Left/Bottom/Right/Top/Recoil/All) or detector number.")
    sys.exit(1)

# Default signal and PV
signal = 'All'
pv_field = 'led_threshold'
value = None

remaining = args[1:]

# Parse remaining args: could be:
# <value>                     → just value, defaults apply
# <signal> <value>            → signal + value, default PV
# <signal> <PV> <value>       → signal + PV + value
# <PV> <value>                (no signal, rare — skip for now)

SIGNAL_ALIASES = {'Energy': 'E', 'energy': 'E', 'e': 'E',
                  'xf': 'XF', 'xn': 'XN',
                  'de': 'dE', 'DE': 'dE'}
VALID_SIGNALS = {'E', 'XF', 'XN', 'dE', 'All'}

if len(remaining) == 1:
    # SetChannel <side/det> <value>
    value = float(remaining[0])

elif len(remaining) == 2:
    # SetChannel <side/det> <signal> <value>  OR  <side/det> <PV> <value>
    arg0 = remaining[0]
    sig = SIGNAL_ALIASES.get(arg0, arg0)
    if sig in VALID_SIGNALS:
        signal = sig
        pv_field = 'led_threshold'
    else:
        pv_field = resolve_pv(arg0)
    value = float(remaining[1])

elif len(remaining) == 3:
    # SetChannel <side/det> <signal> <PV> <value>
    arg0 = remaining[0]
    sig = SIGNAL_ALIASES.get(arg0, arg0)
    if sig in VALID_SIGNALS:
        signal = sig
    else:
        print(f"Unknown signal '{arg0}'")
        sys.exit(1)
    pv_field = resolve_pv(remaining[1])
    value = float(remaining[2])

else:
    print("Too many arguments.")
    print_help()
    sys.exit(1)

if value is None:
    print("No value specified.")
    sys.exit(1)

value = int(value) if value == int(value) else value

print(f"\nSetChannel: target={target}  signal={signal}  PV={pv_field}  value={value}")
print(f"  [mapping: {_mapping_source}]\n")

boards_done = set()
for det in dets:
    set_det_signal(det, signal, pv_field, value, boards_done)

print("\n========= done.")
